/* Estilo compartido FlexStrike VR: indigo profundo + coral de esfuerzo */

:root {
    --fondo: rgb(20, 12, 42);
    --panel: rgba(38, 24, 72, 0.92);
    --campo: rgb(26, 16, 52);
    --borde: rgb(84, 62, 140);
    --texto: rgb(243, 238, 255);
    --texto-suave: rgb(168, 155, 204);
    --acento: rgb(255, 107, 87);
    --acento-hover: rgb(255, 135, 115);
    --violeta: rgb(124, 92, 255);
}

.pantalla {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.fondo {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--fondo);
    -unity-background-scale-mode: scale-and-crop;
}

.velo {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(20, 12, 42, 0.55);
}

.tarjeta {
    width: 460px;
    padding: 40px 44px 36px 44px;
    background-color: var(--panel);
    border-radius: 28px;
    border-width: 2px;
    border-color: var(--borde);
}

.titulo {
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--texto);
    -unity-text-align: middle-center;
    letter-spacing: 3px;
}

.titulo-vr {
    color: var(--acento);
}

.subtitulo {
    font-size: 16px;
    color: var(--texto-suave);
    -unity-text-align: middle-center;
    margin-top: 6px;
    margin-bottom: 30px;
}

.etiqueta {
    font-size: 15px;
    color: var(--texto-suave);
    margin-bottom: 6px;
    margin-left: 4px;
}

/* Campos de texto */
.campo {
    margin-bottom: 18px;
}

.campo .unity-base-text-field__input {
    background-color: var(--campo);
    color: var(--texto);
    font-size: 18px;
    height: 52px;
    padding-left: 16px;
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--borde);
}

.campo:focus .unity-base-text-field__input {
    border-color: var(--violeta);
}

/* Botones */
.boton {
    height: 54px;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--texto);
    background-color: var(--violeta);
    border-radius: 27px;
    border-width: 0;
    margin: 0 0 12px 0;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.boton:hover {
    background-color: rgb(146, 118, 255);
    scale: 1.03 1.03;
}

.boton:active {
    scale: 0.97 0.97;
}

.boton-principal {
    background-color: var(--acento);
    color: rgb(40, 12, 8);
    margin-top: 8px;
}

.boton-principal:hover {
    background-color: var(--acento-hover);
}

.boton-suave {
    background-color: rgba(124, 92, 255, 0.18);
    border-width: 2px;
    border-color: var(--borde);
    color: var(--texto);
    height: 46px;
    font-size: 17px;
}

.boton-suave:hover {
    background-color: rgba(124, 92, 255, 0.38);
}

.fila {
    flex-direction: row;
}

.fila .boton {
    flex-grow: 1;
    flex-basis: 0;
}

.fila .boton:first-child {
    margin-right: 10px;
}

/* Mensaje de error o aviso (oculto hasta que lo uses) */
.aviso {
    font-size: 15px;
    color: var(--acento-hover);
    -unity-text-align: middle-center;
    min-height: 20px;
    margin-bottom: 4px;
}
